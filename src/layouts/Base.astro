---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Private Obsidian vault hosting. Publish only what you mean to share.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-v2.304-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} · obsidi.xyz</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
