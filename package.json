{
  "name": "obsidi-xyz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "wrangler types && astro check",
    "typecheck": "npm run check",
    "types": "wrangler types",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "build": "astro build",
    "deploy:preview": "CLOUDFLARE_ENV=preview astro build && wrangler deploy --env preview",
    "deploy:production": "CLOUDFLARE_ENV=production astro build && wrangler deploy --env production",
    "verify": "npm run format:check && npm run check && npm test && npm run test:workers && openspec validate build-obsidi-saas --strict --no-interactive",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/react": "7.1.9",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "better-auth": "1.7.26",
    "class-variance-authority": "0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.75.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@fission-ai/openspec": "2.0.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
